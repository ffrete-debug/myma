# =============================================================================
# ARK Server Commander — environment template
#
#   cp .env.example .env        # then fill in JWT_SECRET below
#
# docker-compose.yml loads this file with `env_file: .env`, so everything here
# is injected into the container. Docker Compose additionally reads `.env` from
# the project directory for `${VAR}` interpolation — that is how DOCKER_GID
# reaches the image build.
#
# `.env` is git-ignored; `.env.example` is the tracked template. Never put a
# real secret in this file.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# JWT signing key. The backend REFUSES TO START without it — the container will
# crash-loop and the log will point you back here.
#
# Validated in server/config/config.go:
#   * must be set
#   * must be at least 32 characters
#   * must not contain any of these weak substrings (case-insensitive):
#       ark-server-commander-secret-key, secret, password, 123456,
#       default, changeme, test
#     The check is a SUBSTRING match, so "my-secret-key-................" is
#     rejected because it contains "secret".
#
# Generate one:
#   openssl rand -base64 48
#
# (On the rare occasion the generated string happens to contain one of the
# blacklisted substrings, just generate another one.)
#
# Rotating this value invalidates every access token and refresh token that has
# already been issued — all users must log in again.
JWT_SECRET=


# -----------------------------------------------------------------------------
# BACKEND — all optional, defaults shown
# -----------------------------------------------------------------------------

# TCP port the Go API listens on. Bare number, no leading colon.
# Default in code: 8080 (the Dockerfile also sets SERVER_PORT=8080).
SERVER_PORT=8080

# Path to the SQLite database file.
# Default in code: ark_server.db (relative to the working directory).
# The Dockerfile overrides it to /data/ark-commander.db, and docker-compose
# mounts ./data there, so the DB survives container recreation.
DB_PATH=/data/ark-commander.db

# CORS allowlist — comma-separated list of EXACT origins (scheme + host + port,
# no trailing slash, no wildcards).
#
# Default: empty, i.e. same-origin only. No Access-Control-Allow-Origin header
# is emitted at all. Wildcard "*" is no longer supported — see the "Breaking
# changes" section of the README.
#
# Only set this if a browser on a DIFFERENT origin must call the API directly.
# The bundled UI talks to the API through Next.js route handlers on its own
# origin, so the default of empty is correct for the standard docker-compose
# deployment. A matching origin is echoed back together with
# Access-Control-Allow-Credentials: true, so keep this list tight.
#
# Example:
#   CORS_ORIGIN=https://ark.example.com,https://admin.example.com
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# RCON_HOST (optional)
# ---------------------------------------------------------------------------
# Address used to reach a game server's RCON port.
#
# Game servers run as their own containers and publish RCON on the Docker host,
# so this process cannot use "localhost" — inside a container that resolves to
# the manager itself and every RCON dial fails.
#
# Leave blank to auto-detect:
#   - in a container -> host.docker.internal (mapped to the host gateway in
#     docker-compose.yml via extra_hosts)
#   - on bare metal   -> 127.0.0.1
#
# Set it explicitly only when the game servers run on a different machine:
#   RCON_HOST=10.0.0.42
RCON_HOST=

# Reverse-proxy allowlist — comma-separated IPs or CIDRs whose X-Forwarded-For
# header is trusted (passed to Gin's SetTrustedProxies).
#
# Default: empty, i.e. trust NOTHING. Client IPs are read from the real socket
# address, so a client cannot forge audit-log IPs or evade the rate limiter by
# sending its own X-Forwarded-For.
#
# Set this ONLY if the app sits behind a reverse proxy you control, and list
# that proxy — not 0.0.0.0/0.
#
# Example:
#   TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

# Log verbosity: debug | info | warn | error | panic | fatal
# Default: info. Anything unrecognised falls back to info.
LOG_LEVEL=info

# Log encoding: json | console
# Default: json (structured, for log collectors). Use "console" for coloured,
# human-readable output while developing.
LOG_FORMAT=json


# -----------------------------------------------------------------------------
# FRONTEND / CONTAINER — optional
# -----------------------------------------------------------------------------

# Port the Next.js standalone server binds to. Default: 3000
# docker-compose publishes 3000, so change both together if you change this.
# PORT=3000

# Interface the Next.js standalone server binds to. The Dockerfile pins this to
# 0.0.0.0, because Docker presets HOSTNAME to the container ID and Next would
# otherwise bind to that address only. Leave it alone unless you know why.
# HOSTNAME=0.0.0.0

# Seconds entrypoint.sh waits for the two child processes to exit after SIGTERM
# before escalating to SIGKILL. Default: 8. Keep it BELOW the
# stop_grace_period in docker-compose.yml (10s).
# SHUTDOWN_GRACE_SECONDS=8


# -----------------------------------------------------------------------------
# BUILD-TIME ONLY — these are build args, not runtime settings.
# Setting them here does nothing unless docker-compose passes them to
# `build.args`. They are listed for discoverability.
# -----------------------------------------------------------------------------

# GID of the host's "docker" group. The image runs as the non-root user
# "arkcommander", which must be in a group with the HOST's docker GID to open
# /var/run/docker.sock. Default: 999, which is wrong on plenty of distros.
# docker-compose.yml already forwards this one via `${DOCKER_GID:-999}`, so
# setting it in this file DOES take effect for the build.
#
# Find yours:
#   stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999

# Address the Next.js route handlers use to reach the Go API.
#
# NEXT_PUBLIC_* is a BUILD-time concept: `next build` inlines the value as a
# string literal into the compiled output. Putting it in this file has NO
# effect — by runtime the value is already baked in and the variable is never
# read. It must be supplied as a build arg:
#
#   docker build --build-arg NEXT_PUBLIC_API_BASE=http://ark.example:8080/api .
#
# Default baked into the image: http://localhost:8080/api, which is correct for
# the single-container layout where both processes share a network namespace.
# Only override it if you split the API and the UI across containers/hosts.

# ---------------------------------------------------------------------------
# STEAM_API_KEY (optional) — Steam Workshop mod SEARCH
# ---------------------------------------------------------------------------
# Looking a mod up by its Workshop ID never needs a key; only search does.
# Without one the mod browser still works via "add by Workshop ID".
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ---------------------------------------------------------------------------
# BACKUP_PROVIDER — where automated backups are uploaded (optional)
# ---------------------------------------------------------------------------
# One of: s3, dropbox, gdrive, webdav. Leave blank to keep backups local only.
# A value that is not one of those is an error at startup rather than a silent
# fallback, so a typo cannot leave you believing backups are being uploaded.
#
# For backwards compatibility, setting S3_ENDPOINT with no BACKUP_PROVIDER is
# still treated as BACKUP_PROVIDER=s3.
BACKUP_PROVIDER=

# --- dropbox ---------------------------------------------------------------
# Prefer the refresh-token form: Dropbox access tokens now expire after a few
# hours, so a token-only setup stops working silently after the first day.
# Create an app at https://www.dropbox.com/developers/apps
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Short-lived alternative; ignored when a refresh token is set.
DROPBOX_ACCESS_TOKEN=
# Folder inside the app directory, e.g. ark-backups
DROPBOX_PATH=

# --- gdrive (Google Drive) -------------------------------------------------
# Drive has no long-lived token, so an OAuth2 refresh token is required.
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# and grant the https://www.googleapis.com/auth/drive.file scope.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Destination folder id (from its Drive URL). Blank uploads to My Drive root.
GDRIVE_FOLDER_ID=

# --- webdav (Nextcloud, ownCloud, plain DAV) -------------------------------
# Full URL of the target directory, e.g.
#   https://cloud.example.com/remote.php/dav/files/USERNAME/ark-backups
# Nextcloud/ownCloud users should use an app password, not the account password.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# ---------------------------------------------------------------------------
# s3 — S3-compatible object storage (used when BACKUP_PROVIDER=s3)
# ---------------------------------------------------------------------------
# Any S3-compatible endpoint: AWS S3, MinIO, Backblaze B2, Wasabi, Cloudflare R2.
# Leave S3_ENDPOINT blank to disable cloud upload entirely; local backups are
# unaffected either way.
#
# AWS S3:   S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# MinIO:    S3_ENDPOINT=http://minio:9000  and  S3_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional key prefix, e.g. ark-backups -> ark-backups/backup_1_...tar.gz
S3_PREFIX=
# MinIO and most self-hosted gateways require path-style addressing
# (<endpoint>/<bucket>/<key>) because they do not implement virtual-host
# bucket addressing.
S3_PATH_STYLE=false
